{
  "name": "enterprise/wp-ai-emergency-recovery",
  "description": "Enterprise AI-Powered Autonomous WordPress Emergency Recovery System",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.3",
    "ext-json": "*",
    "ext-curl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.8"
  },
  "autoload": {
    "psr-4": {
      "WP_AI_Emergency_Recovery\\": "includes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WP_AI_Emergency_Recovery\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}