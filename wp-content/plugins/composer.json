{
    "name": "user/boq-construction-suite",
    "description": "BuildSuite Pro - Construction & BOQ Suite WordPress plugin",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=7.4",
        "phpoffice/phpspreadsheet": "^1.30"
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "autoload": {
        "psr-4": {
            "BOQ\\": "includes/"
        },
        "classmap": [
            "includes/"
        ]
    },
    "config": {
        "ignore-platform-reqs": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "license": "GPL-2.0-or-later"
}
