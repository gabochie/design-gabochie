# Shared secret for POST /wp-json/gabochie/v1/deploy-status.
# Consumed by the theme (inc/client-portal-verify.php) and by deploy-common.sh.
#
# Install on the server:
#   install -m 600 deploy/secrets/deploy-secret.env.example ~/deploy/deploy-secret.env
#   # then edit with the real value
#
# Both staging and live wp-config.php must expose the same value, e.g.:
#   define('GABOCHIE_DEPLOY_STATUS_SECRET', getenv('GABOCHIE_DEPLOY_STATUS_SECRET') ?: '...');
#
# Rotate with: openssl rand -hex 32
DEPLOY_STATUS_SECRET=replace-with-openssl-rand-hex-32
