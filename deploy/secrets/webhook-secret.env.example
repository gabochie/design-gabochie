# GitHub webhook shared secret for public_html/webhook.php.
#
# Install on the server (never commit the real file):
#   install -m 600 deploy/secrets/webhook-secret.env.example ~/deploy/webhook-secret.env
#   # then edit ~/deploy/webhook-secret.env with the real value
#
# The same value must be stored in the GitHub webhook settings:
#   Settings -> Webhooks -> https://design.gabochie.com/webhook.php -> Secret
#
# Rotate with: openssl rand -hex 32
GABOCHIE_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32
