<?xml version="1.0"?>
<ruleset name="Gabochie Design">
    <description>WordPress coding standards for in-house plugins and the gabochie-value theme.</description>

    <file>wp-content/plugins/gabochie-*</file>
    <file>wp-content/plugins/includes</file>
    <file>wp-content/plugins/boq-construction-suite.php</file>
    <file>wp-content/plugins/boq-silence-rest-output</file>
    <file>wp-content/plugins/wp-ai-emergency-recovery</file>
    <file>wp-content/plugins/tests</file>
    <file>wp-content/themes/gabochie-value</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/assets/*</exclude-pattern>
    <exclude-pattern>*/languages/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <config name="minimum_supported_wp_version" value="6.5"/>
    <config name="testVersion" value="8.1-"/>

    <rule ref="WordPress">
        <exclude name="WordPress.Files.FileName"/>
        <exclude name="WordPress.WP.I18n.MissingTranslatorsComment"/>
        <exclude name="WordPress.PHP.YodaConditions"/>
    </rule>

    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="gabochie"/>
                <element value="gv"/>
            </property>
        </properties>
    </rule>

    <rule ref="PHPCompatibilityWP"/>
</ruleset>
