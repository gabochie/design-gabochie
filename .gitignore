# Local / secret — never ship
/wp-config.php
/wp-config-local.php
/wp-cli.phar
/wp-cli*.yml

# Debug / logs
**/error_log
**/*.log
**/*.bak
**/debug.log

# Backups / caches (not source of truth)
wp-content/uploads/
wp-content/cache/
wp-content/upgrade/
wp-content/upgrade-temp-backup/
wp-content/ai1wm-backups/
wp-content/blog-exports/
wp-content/gabochie-wp-content/
wp-content/litespeed/
wp-content/wp-rocket-config/
wp-content/advanced-cache.php
wp-content/db.php
wp-content/object-cache.php

# Server environment artifacts (created by cPanel/ACME)
.user.ini
.well-known/
cgi-bin/

# Deploy infrastructure
# The versioned deploy scripts live in /deploy/ and ARE tracked. The legacy
# root-level entrypoints are server-only and must never be committed.
/deploy.sh
/webhook.php

# Secrets: never commit real environment values. Examples are tracked.
/deploy/secrets/*.env
!/deploy/secrets/*.env.example
/deploy/backups/
*.pem
*.key
!deploy/secrets/*.example

# Live-site keepers (preserved across deploys; NOT repo content)
/ads.txt
/BingSiteAuth.xml
/.htaccess.bk
/.litespeed_flag
/wordfence-waf.php

# AI-Growth-OS dev-only vendor (phpstan binaries; plugin disabled on staging)
wp-content/plugins/AI-Growth-OS/vendor/

# Local-only tooling (never deploy)
wp-content/plugins/gabochie-deploy-local/

# Local debug endpoint (xdebug_info() — never ship)
local-xdebuginfo.php

# Tooling caches / dependencies
/vendor/
/node_modules/
/.phpunit.result.cache
/.phpcs.cache
/.phpstan.cache/
/build/

# OS junk
.DS_Store
Thumbs.db
desktop.ini
